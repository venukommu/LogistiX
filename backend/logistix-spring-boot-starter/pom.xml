<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.logistix</groupId>
        <artifactId>logistix-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>logistix-spring-boot-starter</artifactId>
    <name>LogistiX Spring Boot Starter</name>
    <description>Spring Boot auto-configuration and component scanning for LogistiX framework</description>

    <dependencies>
        <dependency>
            <groupId>org.logistix</groupId>
            <artifactId>logistix-dsl</artifactId>
        </dependency>

        <dependency>
            <groupId>org.logistix</groupId>
            <artifactId>logistix-engine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.logistix</groupId>
            <artifactId>logistix-domain</artifactId>
        </dependency>

        <dependency>
            <groupId>org.logistix</groupId>
            <artifactId>logistix-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.logistix</groupId>
            <artifactId>logistix-ai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.logistix</groupId>
            <artifactId>logistix-rag</artifactId>
        </dependency>

        <dependency>
            <groupId>org.logistix</groupId>
            <artifactId>logistix-mcp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
